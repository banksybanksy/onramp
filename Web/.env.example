# Onramp web app environment. Everything is optional: with no keys set, the
# app falls back to bundled sample data and still runs end to end.

# Mapbox: basemap tiles, geocoding, and directions. Free token at
# https://account.mapbox.com/. This is a public (pk.) token that ships in the
# client bundle by design, so restrict it to your deploy domain in the Mapbox
# dashboard rather than treating it as a secret.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# 511 SF Bay Open Data API key: enables live traffic incidents and regional
# transit service alerts. Free key at https://511.org/open-data/token.
BAY_511_API_KEY=

# --- Optional overrides (sensible 511 / Caltrans defaults are built in) ---
# BAY_511_TRANSIT_AGENCY=RG
# TRANSIT_ALERTS_REGIONAL_URL=
# TRAFFIC_INCIDENTS_FEED_URL=
# CALTRANS_CCTV_DISTRICT=4
# CAMERA_FEED_URLS=
# NEXT_PUBLIC_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11
# NEXT_PUBLIC_NOTIFICATION_POLL_MS=60000
# MAPBOX_DIRECTIONS_PROFILE=driving
